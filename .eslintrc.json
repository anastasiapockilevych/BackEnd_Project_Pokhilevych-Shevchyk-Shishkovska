{
    "plugins": ["prettier", "import"],
    "env": {
        "node": true,
        "commonjs": true,
        "es2021": true,
        "jest": true
    },
    "extends": ["airbnb-base", "plugin:prettier/recommended"],
    "overrides": [],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "rules": {
        "no-underscore-dangle": ["error", { "allow": ["_id", "__v"] }],
        "no-plusplus": "off",
        "func-names": "off",
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "quotes": ["error", "single"],
        "no-console": 0,
        "prettier/prettier": [
            "warn",
            {
                "singleQuote": true,
                "tabWidth": 4,
                "trailingComma": "all",
                "printWidth": 100,
                "arrowParens": "avoid",
                "endOfLine": "auto"
            }
        ]
    }
}